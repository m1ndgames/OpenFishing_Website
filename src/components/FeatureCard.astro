---
// One numbered "compartment" of the tackle box: a close-up from the live demo,
// a quiet section index (01–04), a title and what it holds. The whole card
// opens the matching demo page (stretched link on the title, ↗ cue): one
// target per card; the docs stay in the footer and /docs.
import ThemedShot from './ThemedShot.astro';

interface Props {
  number: number;
  title: string;
  /** Screenshot base name in public/screenshots (dark + `-light`). */
  img: string;
  demo: string;
  newTab: string;
  credit?: string;
}
const { number, title, img, demo, newTab, credit } = Astro.props;
const index = String(number).padStart(2, '0');
// Phones zoom into each well so the app's text stays readable; this is the
// point each crop zooms toward (the map toward its pins, the rest top-left,
// where the app's content starts).
const focus = img === 'box-spots' ? 'center' : 'top left';
---

<article class="card card-hover compartment">
  <div class="well" style={`--focus: ${focus}`}>
    <ThemedShot name={img} alt="" width={1000} height={625} />
    {credit && <span class="credit">{credit}</span>}
  </div>
  <div class="body">
    <h3 class="title">
      <span class="index" aria-hidden="true">{index}</span>
      <a class="open" href={demo} target="_blank" rel="noopener">
        {title}<span class="sr-only"> {newTab}</span>
      </a>
      <svg class="cue" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </h3>
    <p class="desc"><slot /></p>
  </div>
</article>

<style>
  .compartment {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: inherit;
  }
  .well {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--of-bg-elevated);
    border-bottom: 1px solid var(--of-border-subtle);
    overflow: hidden;
  }
  .well :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  /* Phones: a well is ~340px wide, which would shrink the app's 14px text to
     ~8px. Zoom in 1.35× toward the crop's focus so it reads at ~11px. */
  @media (max-width: 640px) {
    .well :global(img) {
      transform: scale(1.35);
      transform-origin: var(--focus);
    }
  }
  /* Section index: plain mono, deliberately unlike the app's #0001 lure plate
     (which the screenshots already show), so the two never read as one. */
  .index {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--of-text-3);
  }
  .cue {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--of-text-3);
    transition: color var(--of-dur-fast) var(--of-ease), transform var(--of-dur-fast) var(--of-ease);
  }
  .compartment:hover .cue {
    color: var(--of-accent);
    transform: translate(2px, -2px);
  }
  .credit {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 2px 6px;
    font-size: 0.75rem;
    color: var(--of-text-2);
    background: color-mix(in srgb, var(--of-bg-base) 92%, transparent);
    border-top-left-radius: var(--of-radius-sm);
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem 1.25rem;
  }
  .title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--of-text-bright);
    margin: 0;
  }
  .open {
    color: inherit;
    text-decoration: none;
  }
  /* Stretched link: the whole card opens the demo page. */
  .open::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .open:focus-visible {
    outline: none;
  }
  .open:focus-visible::after {
    outline: 2px solid var(--of-accent-solid);
    outline-offset: -2px;
    border-radius: var(--radius-card);
  }
  .compartment:hover .title {
    color: var(--of-accent);
  }
  .desc {
    flex: 1;
    color: var(--of-text-2);
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
  }
</style>
