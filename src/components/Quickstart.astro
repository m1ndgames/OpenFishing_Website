---
import FeatureList from './FeatureList.astro';
import { serverMeta } from '../lib/features';
import { SITE } from '../consts';
import { useTranslations, localeUrl } from '../i18n/utils';
import { defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const cmd = `docker run -d -p 3000:3000 \\
  -e BASE_URL=http://localhost:3000 \\
  -v openfishing-db:/app/data \\
  -v openfishing-uploads:/app/uploads \\
  ghcr.io/m1ndgames/openfishing:latest`;

const LOCAL_URL = 'http://localhost:3000';
// Operator features sit here, where self-hosters are already reading.
const server = t.features.server.map((item, i) => ({ ...item, icon: serverMeta[i].icon, href: localeUrl(lang, serverMeta[i].href) }));
const [afterBefore, afterAfter = ''] = t.qs.afterRun.split('{url}');
---

<section id="install" class="qs">
  <div class="qs-inner">
    <div class="qs-copy">
      <p class="qs-kicker">{t.qs.kicker}</p>
      <h2>{t.qs.heading}</h2>
      <p class="qs-needs" id="qs-needs">{t.qs.needs}</p>
      <ul class="qs-reqs" aria-labelledby="qs-needs">
        {
          t.qs.reqs.map((r) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {r}
            </li>
          ))
        }
      </ul>
      <p>{t.qs.stays}</p>
      <p class="qs-new">{t.qs.newToDocker}</p>
      <div class="qs-links">
        <a class="btn-text" href={localeUrl(lang, '/docs/getting-started/installation')}>
          {t.qs.docs}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="qs-source" href={SITE.github} target="_blank" rel="noopener">
          {t.qs.source}<span class="sr-only"> {t.newTab}</span>
        </a>
      </div>
    </div>

    <div class="qs-run">
      <div class="qs-code card">
        <div class="qs-code-bar">
          <span class="qs-file">{t.qs.terminal}</span>
          <!-- Hidden until the script runs: without JavaScript it could not copy. -->
          <button
            id="copy-run"
            class="qs-copy-btn"
            type="button"
            hidden
            aria-label={t.qs.copyAria}
            data-copied={t.qs.copied}
            data-failed={t.qs.copyFailed}
          >{t.qs.copy}</button>
        </div>
        <pre><code id="run-cmd">{cmd}</code></pre>
      </div>
      <p id="copy-status" class="qs-status" role="status" aria-live="polite"></p>
      <p class="qs-after">{afterBefore}<code>{LOCAL_URL}</code>{afterAfter}</p>
    </div>

    <div class="qs-server">
      <FeatureList id="server" heading={t.features.serverHeading} items={server} />
    </div>
  </div>
</section>

<style>
  .qs {
    border-bottom: 1px solid var(--of-border-subtle);
    scroll-margin-top: 1rem;
  }
  .qs-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) 1.25rem;
    display: grid;
    /* minmax(0, …): let tracks shrink below the command's unbreakable width
       (the <pre> scrolls instead of widening the page on small phones). */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .qs-kicker {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--of-accent);
    margin: 0 0 0.5rem;
  }
  .qs-copy h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 0.75rem;
  }
  .qs-copy p:not(.qs-kicker) {
    max-width: 38rem;
    color: var(--of-text-2);
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  /* Prerequisites as a scannable checklist (same check mark as the hero facts). */
  .qs-copy p.qs-needs {
    margin: 0 0 0.5rem;
    color: var(--of-text);
    font-weight: 600;
  }
  .qs-reqs {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 38rem;
  }
  .qs-reqs li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--of-text-2);
    line-height: 1.5;
  }
  .qs-reqs svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--of-accent);
  }
  .qs-copy p.qs-new {
    margin-bottom: 0.25rem;
  }
  .qs-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }
  .qs-source {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--of-text-2);
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: var(--of-border-strong);
    text-underline-offset: 3px;
  }
  .qs-source:hover {
    color: var(--of-accent);
  }
  .qs-code {
    overflow: hidden;
  }
  .qs-code-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 8px 8px 14px;
    background: var(--of-bg-elevated);
    border-bottom: 1px solid var(--of-border-subtle);
  }
  .qs-file {
    color: var(--of-text-2);
    font-size: 0.78rem;
    font-family: var(--font-mono);
  }
  .qs-copy-btn {
    margin-left: auto;
    min-height: 40px;
    min-width: 4.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--of-text-2);
    background: var(--of-bg-surface);
    border: 1px solid var(--of-border);
    border-radius: var(--of-radius-sm);
    padding: 0.25rem 0.75rem;
    cursor: pointer;
    transition: color var(--of-dur-fast) var(--of-ease), border-color var(--of-dur-fast) var(--of-ease);
  }
  .qs-copy-btn:hover {
    color: var(--of-accent);
    border-color: var(--of-accent-border);
  }
  .qs-code pre {
    margin: 0;
    padding: 1.1rem 1.2rem;
    overflow-x: auto;
    background: var(--of-bg-surface);
  }
  .qs-code pre code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--of-text);
    white-space: pre;
  }
  .qs-status {
    margin: 0.5rem 0 0;
    min-height: 1.25rem;
    color: var(--of-warning);
    font-size: 0.8125rem;
  }
  .qs-status:empty {
    min-height: 0;
    margin: 0;
  }
  .qs-after {
    margin: 0.75rem 0 0;
    color: var(--of-text-2);
    font-size: 0.9rem;
  }
  .qs-after code {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--of-accent);
    background: var(--of-accent-bg);
    padding: 0.1rem 0.35rem;
    border-radius: var(--of-radius-sm);
  }

  .qs-server {
    grid-column: 1 / -1;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }
  .qs-copy-btn[hidden] {
    display: none;
  }

  @media (max-width: 820px) {
    .qs-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const btn = document.getElementById('copy-run');
  const code = document.getElementById('run-cmd');
  const status = document.getElementById('copy-status');
  if (btn) btn.hidden = false;

  function selectCommand() {
    if (!code) return;
    const range = document.createRange();
    range.selectNodeContents(code);
    const sel = window.getSelection();
    sel?.removeAllRanges();
    sel?.addRange(range);
  }

  btn?.addEventListener('click', async () => {
    if (!code?.textContent) return;
    try {
      await navigator.clipboard.writeText(code.textContent);
      const prev = btn.textContent;
      btn.textContent = btn.dataset.copied || 'Copied!';
      if (status) {
        status.textContent = '';
        // Announce success without showing a second visible message.
        status.classList.add('sr-only');
        status.textContent = btn.dataset.copied || '';
      }
      setTimeout(() => (btn.textContent = prev), 1500);
    } catch {
      // Clipboard blocked (insecure context, permissions): select the text
      // so the visitor can copy it themselves, and say so.
      selectCommand();
      if (status) {
        status.classList.remove('sr-only');
        status.textContent = btn.dataset.failed || '';
      }
    }
  });
</script>
