---
// A demo screenshot in both app themes: `name.jpg` (dark) and `name-light.jpg`.
// Only the variant matching the page theme is displayed; the hidden one is
// `display: none`, and when lazy, browsers don't download it. `eager` (the
// hero) loads both, so light-mode visitors don't wait on a lazy LCP image;
// only the dark default gets high fetch priority.
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  /** Above the fold: load the dark (default) variant eagerly with high priority. */
  eager?: boolean;
  class?: string;
}
const { name, alt, width, height, eager = false, class: cls } = Astro.props;
---

<img
  class:list={['shot-dark', cls]}
  src={`/screenshots/${name}.jpg`}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
<img
  class:list={['shot-light', cls]}
  src={`/screenshots/${name}-light.jpg`}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>

<style>
  .shot-dark {
    display: block;
  }
  .shot-light {
    display: none;
  }
  :global([data-theme='light']) .shot-dark {
    display: none;
  }
  :global([data-theme='light']) .shot-light {
    display: block;
  }
</style>
