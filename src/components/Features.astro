---
import FeatureCard from './FeatureCard.astro';
import FeatureList from './FeatureList.astro';
import { coreMeta, fishingMeta } from '../lib/features';
import { useTranslations, localeUrl } from '../i18n/utils';
import { defaultLang, languages, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const core = t.features.core.map((item, i) => ({ ...item, ...coreMeta[i] }));
const fishing = t.features.fishing.map((item, i) => ({ ...item, icon: fishingMeta[i].icon, href: localeUrl(lang, fishingMeta[i].href) }));
const [extrasBefore, extrasAfter = ''] = t.features.extras.split('{languages}');
const languageNames = Object.values(languages).join(', ');
---

<section id="features" class="features">
  <div class="features-inner">
    <h2 class="section-title">{t.features.heading}</h2>

    <div class="core-grid">
      {
        core.map((f, i) => (
          <FeatureCard
            number={i + 1}
            title={f.title}
            img={f.img}
            credit={f.map ? t.mapCredit : undefined}
            demo={f.demo}
            newTab={t.newTab}
          >
            {f.desc}
          </FeatureCard>
        ))
      }
    </div>

    <div class="more">
      <FeatureList id="fishing" heading={t.features.fishingHeading} items={fishing} />
      <p class="extras">
        {extrasBefore}<a href={localeUrl(lang, '/docs/features/languages')}>{languageNames}</a>{extrasAfter}
      </p>
    </div>
  </div>
</section>

<style>
  .features {
    border-bottom: 1px solid var(--of-border-subtle);
  }
  .features-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(3.5rem, 7vw, 5.5rem) 1.25rem;
  }
  .section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 2rem;
  }
  .core-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  /* Two across at most: the wells show 576px demo crops at about 1:1,
     so the app's own text stays legible. */
  @media (min-width: 640px) {
    .core-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  .more {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .extras {
    margin: 1.5rem 0 0;
    color: var(--of-text-2);
    font-size: 0.875rem;
  }
  .extras a {
    color: var(--of-text);
    text-decoration: underline;
    text-decoration-color: var(--of-border-strong);
    text-underline-offset: 3px;
  }
  .extras a:hover {
    color: var(--of-accent);
  }
</style>
