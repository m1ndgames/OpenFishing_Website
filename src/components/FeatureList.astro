---
// A titled, ruled list of smaller features (icon, name, one line), each
// linking to its docs page. Used for "For your fishing" (Features) and
// "For your server" (Quickstart). Lays out 1 → 3 columns.
import type { FeatureText } from '../i18n/ui';

interface Item extends FeatureText {
  icon: string;
  href: string;
}
interface Props {
  id: string;
  heading: string;
  items: Item[];
}
const { id, heading, items } = Astro.props;
---

<div class="group">
  <h3 class="group-title" id={`group-${id}`}>{heading}</h3>
  <ul class="list" aria-labelledby={`group-${id}`}>
    {
      items.map((f) => (
        <li>
          <a class="item" href={f.href}>
            <span class="icon" set:html={f.icon} aria-hidden="true" />
            <span class="text">
              <span class="name">
                {f.title}
                {f.badge && <span class="chip">{f.badge}</span>}
              </span>
              <span class="desc">{f.desc}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .group-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--of-text-bright);
    margin: 0 0 0.75rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 2rem;
    border-top: 1px solid var(--of-border-subtle);
  }
  @media (min-width: 900px) {
    .list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .list li {
    border-bottom: 1px solid var(--of-border-subtle);
  }
  .item {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 0.25rem;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: var(--of-radius-sm);
    transition: background var(--of-dur-fast) var(--of-ease);
  }
  .item:hover {
    background: var(--of-bg-hover);
  }
  .item:hover .name {
    color: var(--of-accent);
  }
  .icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 0.1rem;
    color: var(--of-accent);
  }
  .icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--of-text-bright);
    transition: color var(--of-dur-fast) var(--of-ease);
  }
  .desc {
    color: var(--of-text-2);
    font-size: 0.875rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
</style>
