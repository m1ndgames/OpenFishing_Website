---
import { SITE } from '../consts';
import Logo from './Logo.astro';
import ThemedShot from './ThemedShot.astro';
// Written by scripts/screenshots.mjs with the hero capture, so the link
// always opens the catch the screenshot shows.
import heroCatch from '../lib/hero-catch.json';
import { useTranslations } from '../i18n/utils';
import { defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy" data-fish-clear>
      <div class="hero-brand">
        <Logo class="hero-logo" />
        <h1 class="hero-title">{t.hero.titleLine1}<br />{t.hero.titleAccent}</h1>
      </div>
      <p class="hero-sub">{t.hero.sub}</p>
      <div class="hero-cta">
        <div class="hero-demo">
          <a class="btn-primary" href={SITE.demo} target="_blank" rel="noopener">
            {t.hero.ctaDemo}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="sr-only">{` ${t.newTab}`}</span>
          </a>
          <span class="hero-note">{t.hero.demoNote}</span>
        </div>
        <a class="btn-text hero-install" href="#install">
          {t.hero.ctaInstall}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
      <ul class="hero-facts">
        {
          t.hero.facts.map((f) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero-shot card" data-fish-below>
      <a class="hero-shot-link" href={`${SITE.demo}${heroCatch.path}`} target="_blank" rel="noopener">
        <ThemedShot name="hero" alt={t.hero.shotAlt} width={1400} height={847} eager />
        <span class="sr-only">{` ${t.newTab}`}</span>
      </a>
      <figcaption class="hero-credit">{t.mapCredit}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--of-border-subtle);
  }
  .hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) 1.25rem clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }
  .hero-brand {
    width: fit-content;
    max-width: 100%;
    margin-bottom: 1.1rem;
  }
  .hero-logo {
    width: 100%;
    max-width: 17rem;
    height: auto;
    display: block;
    color: var(--of-accent);
    margin-bottom: 0.4rem;
  }
  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .hero-sub {
    color: var(--of-text-2);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 32rem;
    margin: 0 0 1.75rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.75rem;
  }
  .hero-demo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hero-install {
    min-height: 44px;
  }
  .hero-note {
    color: var(--of-text-2);
    font-size: 0.8125rem;
    padding-left: 0.25rem;
  }
  .hero-facts {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--of-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hero-facts li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--of-text);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .hero-facts svg {
    color: var(--of-accent);
    flex-shrink: 0;
  }

  .hero-shot {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 992 / 600;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }
  /* The screenshot opens this exact catch in the demo: the frame lifts
     toward the accent on hover/focus, like the compartments. */
  .hero-shot {
    transition: border-color var(--of-dur-fast) var(--of-ease), box-shadow var(--of-dur-fast) var(--of-ease);
  }
  .hero-shot:hover,
  .hero-shot:has(.hero-shot-link:focus-visible) {
    border-color: var(--of-accent-border);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35), 0 8px 32px var(--of-accent-glow);
  }
  .hero-shot-link {
    display: block;
    height: 100%;
  }
  .hero-shot-link:focus-visible {
    outline-offset: -2px;
  }
  /* display is owned by ThemedShot (theme swap) */
  .hero-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  /* The capture includes OpenStreetMap tiles; credit them on the frame. */
  .hero-credit {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 2px 8px;
    font-size: 0.75rem;
    color: var(--of-text-2);
    background: color-mix(in srgb, var(--of-bg-base) 92%, transparent);
    border-top-left-radius: var(--of-radius-sm);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
  }
  /* Phones: zoom into the photo and the top facts (fish, 23, length) so they
     stay readable; the map, and with it the credit, is cropped away. The
     numbers follow the 992x600 capture in scripts/screenshots.mjs: show its
     left 720px and top 405px. */
  @media (max-width: 640px) {
    .hero-shot {
      aspect-ratio: 720 / 405;
    }
    .hero-shot :global(img) {
      width: calc(100% * 992 / 720);
      max-width: none;
      height: auto;
    }
    .hero-credit {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .hero-cta {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-cta :global(.btn-primary),
    .hero-install {
      justify-content: center;
    }
    .hero-note {
      text-align: center;
      padding-left: 0;
    }
  }
</style>
